+const replaceAsync = async (str, re, fn) => {
+  const parts = [], jobs = [];
+  let last = 0, m;
+  re.lastIndex = 0;
+  while ((m = re.exec(str))) {
+    jobs.push(fn(...m));
+    parts.push(str.slice(last, m.index));
+    last = m.index + m[0].length;
+  }
