{
  "name": "outreach-mailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.12.1",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "html2canvas-pro": "^2.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "resedit": "^3.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "xlsx": "^0.18.5"
  },
  "description": "Send and schedule personalised outreach emails (QQ, Gmail, 163, Yahoo, iCloud, Zoho, any SMTP) and build resumes",
  "author": "Muhammad Hamim",
  "main": "electron/main.cjs",
  "homepage": "./",
  "build": {
    "appId": "com.hamim.outreachmailer",
    "productName": "Outreach Mailer",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Outreach-Mailer-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    },
    "portable": {
      "artifactName": "Outreach-Mailer-Portable.exe"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "productName": "Outreach Mailer"
}
