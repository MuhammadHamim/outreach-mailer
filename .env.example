# --- Login to the website (single user) ---
APP_PASSWORD=change-this-long-password
SESSION_SECRET=paste-a-long-random-string

# --- QQ mailbox (SMTP authorization code, NOT the login password) ---
QQ_EMAIL=hamim0@qq.com
QQ_AUTH_CODE=your-qq-smtp-authorization-code
FROM_NAME=Muhammad Hamim

# --- Firestore: base64 of the service-account JSON (see README). Leave empty to use an in-memory test DB ---
FIREBASE_SERVICE_ACCOUNT_B64=

# --- dry = log emails instead of sending (for testing). Remove or set smtp for real sending ---
MAIL_MODE=smtp
